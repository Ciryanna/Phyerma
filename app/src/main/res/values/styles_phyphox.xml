<?xml version="1.0" encoding="utf-8"?>

<resources xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- For now, splash screen shows only in dark theme-->
    <style name="splashTheme" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@drawable/splash_screen</item>
        <item name="android:windowSplashScreenBackground">@color/phyphox_brand</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_phyerma_logo</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/phyphox_brand</item>
    </style>

    <style name="Theme.Phyphox.Dialog.Alert.Light" parent="ThemeOverlay.Material3.Dialog.Alert">
        <item name="textColorAlertDialogListItem">@color/phyphox_black_100</item>
        <item name="colorAccent">@color/phyphox_primary</item>
        <item name="android:colorBackground">@color/phyphox_white_100</item>
    </style>

    <style name="Theme.Phyphox.Dialog.Alert.Dark" parent="ThemeOverlay.Material3.Dialog.Alert">
        <item name="textColorAlertDialogListItem">@color/phyphox_white_100</item>
        <item name="colorAccent">@color/phyphox_primary</item>
        <item name="android:colorBackground">@color/phyphox_black_60</item>
    </style>

    <style name="rwthDialog" parent="Theme.AppCompat.Light.Dialog.Alert">
        <item name="colorAccent">@color/phyphox_rwth_primary</item>
    </style>

    <style name="PreferenceThemeOverlay.v14.Phyphox.Dark" parent="PreferenceThemeOverlay.v14">
        <item name="android:tint">@color/phyphox_white_100</item>
    </style>

    <style name="PreferenceThemeOverlay.v14.Phyphox.Light" parent="PreferenceThemeOverlay.v14">
        <item name="android:tint">@color/phyphox_black_100</item>
    </style>

    <style name="MaterialButtonTheme" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/phyphox_black_100</item>
        <item name="android:textColor">@color/phyphox_white_100</item>

    </style>

    <style name="BottomSheetDialog.Light" parent="Widget.Material3.BottomSheet.Modal">
        <item name="backgroundTint">@color/phyphox_white_100</item>
        <item name="android:textColor">@color/phyphox_black_60</item>
        <item name="shapeAppearance">@style/ShapeAppearance.App.LargeComponent</item>
    </style>

    <style name="BottomSheetDialog.Dark" parent="Widget.Material3.BottomSheet">
        <item name="backgroundTint">@color/phyphox_black_40</item>
        <item name="android:textColor">@color/phyphox_white_100</item>
        <item name="shapeAppearance">@style/ShapeAppearance.App.LargeComponent</item>
    </style>

    <style name="ShapeAppearance.App.LargeComponent" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerSize">24dp</item>
    </style>

    <style name="PhyermaUntintedImage">
        <item name="android:tint">@null</item>
        <item name="tint">@null</item>
    </style>


    <style name="PhyermaPanelSection">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:layout_marginBottom">6dp</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:textColor">@color/phyphox_primary_weak</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="PhyermaPanelCard">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_surface_card</item>
        <item name="android:padding">14dp</item>
    </style>
</resources>
