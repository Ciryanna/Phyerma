<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/calibRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/phyphox_black_80"
    android:clipToPadding="false"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/calibBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:paddingBottom="12dp"
            android:text="@string/phyerma_back"
            android:textColor="@color/phyphox_primary_weak"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/phyerma_calib_clock_title"
            android:textColor="@color/phyphox_white_100"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/phyerma_calib_explain"
            android:textColor="@color/phyphox_white_70"
            android:textSize="14sp" />

        <RadioGroup
            android:id="@+id/calibLens"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/calibLensBack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/phyerma_calib_lens_back"
                android:textColor="@color/phyphox_white_90" />

            <RadioButton
                android:id="@+id/calibLensFront"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:text="@string/phyerma_calib_lens_front"
                android:textColor="@color/phyphox_white_90" />
        </RadioGroup>

        <androidx.camera.view.PreviewView
            android:id="@+id/calibPreview"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginTop="12dp" />

        <Button
            android:id="@+id/calibStart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/phyerma_calib_start" />

        <TextView
            android:id="@+id/calibStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/phyphox_white_90"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/calibResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="monospace"
            android:textColor="@color/phyphox_primary_weak"
            android:textSize="14sp" />

        <LinearLayout
            android:id="@+id/calibPairs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical"
            android:visibility="gone" />

        <EditText
            android:id="@+id/calibEdit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/phyerma_calib_edit_hint"
            android:inputType="numberDecimal|numberSigned"
            android:textColor="@color/phyphox_white_100"
            android:visibility="gone" />

        <Button
            android:id="@+id/calibApply"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/phyerma_calib_apply"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
