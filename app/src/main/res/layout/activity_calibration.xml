<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/phyphox_black_80">

    <include layout="@layout/include_page_header" />

    <include layout="@layout/include_bottom_nav" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/mainBottomNav"
        android:layout_below="@id/pageHeader"
        android:clipToPadding="false"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="@string/phyerma_panel_intro"
                android:textColor="@color/phyphox_white_70"
                android:textSize="13sp" />

            <TextView
                style="@style/PhyermaPanelSection"
                android:text="@string/phyerma_panel_section_device" />

            <LinearLayout
                style="@style/PhyermaPanelCard"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/deviceCardTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/phyphox_white_100"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/deviceCardBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="monospace"
                    android:textColor="@color/phyphox_white_90"
                    android:textSize="13sp" />

                <CheckBox
                    android:id="@+id/includeDevice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/phyerma_panel_include"
                    android:textColor="@color/phyphox_white_90" />
            </LinearLayout>

            <TextView
                style="@style/PhyermaPanelSection"
                android:text="@string/phyerma_panel_section_tests" />

            <LinearLayout
                style="@style/PhyermaPanelCard"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/phyerma_calib_clock_title"
                    android:textColor="@color/phyphox_white_100"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/phyerma_calib_clock_what"
                    android:textColor="@color/phyphox_white_70"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/clockStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="monospace"
                    android:textColor="@color/phyphox_white_90"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/clockMeasure"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/phyerma_calib_measure" />

                    <Button
                        android:id="@+id/clockClear"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="@string/phyerma_calib_clear" />
                </LinearLayout>

                <CheckBox
                    android:id="@+id/includeClock"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/phyerma_panel_include"
                    android:textColor="@color/phyphox_white_90" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="@string/phyerma_panel_more"
                android:textColor="@color/phyphox_white_60"
                android:textSize="12sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="@string/phyerma_panel_footer"
                android:textColor="@color/phyphox_white_60"
                android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>
</RelativeLayout>
