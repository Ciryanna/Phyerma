<phyphox version="1.20" locale="en">
  <title>Pitch finder</title>
  <category>Phyerma</category>
  <description>Listens through the microphone and shows the loudest frequency and the spectrum.</description>
  <icon>Hz</icon>
  <data-containers>
    <container size="4096">rec</container>
    <container size="4096">re</container>
    <container size="4096">im</container>
    <container size="4096">mag</container>
    <container size="2047">spec</container>
    <container size="2047">freq</container>
    <container size="1">peak</container>
    <container size="1">f0</container>
  </data-containers>
  <input>
    <audio rate="48000">
      <output component="out">rec</output>
    </audio>
  </input>
  <analysis sleep="0.2" requireFill="rec">
    <fft>
      <input as="re">rec</input>
      <output as="re">re</output>
      <output as="im">im</output>
    </fft>
    <formula formula="sqrt([1]^2+[2]^2)">
      <input>re</input>
      <input>im</input>
      <output>mag</output>
    </formula>
    <subrange>
      <input as="from" type="value">1</input>
      <input as="length" type="value">2047</input>
      <input as="in">mag</input>
      <output>spec</output>
    </subrange>
    <ramp>
      <input as="start" type="value">11.71875</input>
      <input as="stop" type="value">23988.28</input>
      <input as="length" type="value">2047</input>
      <output>freq</output>
    </ramp>
    <max>
      <input as="y">spec</input>
      <input as="x">freq</input>
      <output as="max">peak</output>
      <output as="position">f0</output>
    </max>
  </analysis>
  <views>
    <view label="Pitch">
      <value label="Loudest frequency" unit="Hz" precision="1" size="3"><input>f0</input></value>
      <graph label="Spectrum" labelX="f" unitX="Hz" labelY="amplitude" unitY="a.u." logX="true" partialUpdate="true">
        <input axis="x">freq</input>
        <input axis="y">spec</input>
      </graph>
    </view>
  </views>
  <export>
    <set name="Spectrum">
      <data name="Frequency (Hz)">freq</data>
      <data name="Amplitude (a.u.)">spec</data>
    </set>
  </export>
</phyphox>
