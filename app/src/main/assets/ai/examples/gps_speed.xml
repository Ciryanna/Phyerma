<phyphox version="1.20" locale="en">
  <title>GPS speedometer</title>
  <category>Phyerma</category>
  <description>Shows your speed from GPS in km/h, with the top speed so far. Use it outdoors.</description>
  <icon>GS</icon>
  <data-containers>
    <container size="0">v</container>
    <container size="0">vkmh</container>
    <container size="0">gps_time</container>
    <container size="1">top</container>
  </data-containers>
  <input>
    <location>
      <output component="v">v</output>
      <output component="t">gps_time</output>
    </location>
  </input>
  <analysis sleep="0.5">
    <formula formula="[1]*3.6">
      <input>v</input>
      <output>vkmh</output>
    </formula>
    <max>
      <input as="y">vkmh</input>
      <output as="max">top</output>
    </max>
  </analysis>
  <views>
    <view label="Speed">
      <value label="Speed" unit="km/h" precision="1" size="3"><input>vkmh</input></value>
      <value label="Top speed" unit="km/h" precision="1"><input>top</input></value>
      <graph label="Speed" labelX="t" unitX="s" labelY="v" unitY="km/h" timeOnX="true" partialUpdate="true">
        <input axis="x">gps_time</input>
        <input axis="y">vkmh</input>
      </graph>
    </view>
  </views>
  <export>
    <set name="Speed">
      <data name="Time (s)">gps_time</data>
      <data name="Speed (km/h)">vkmh</data>
    </set>
  </export>
</phyphox>
